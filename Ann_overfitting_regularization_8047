    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Tanh Activation Function\n",
        "\n",
        "def tanh(x):\n",
        "    return np.tanh(x)\n",
        "\n",
        "# Forward Propagation\n",
        "\n",
        "def forward(X):\n",
        "    Z1 = np.dot(X, W1) + b1\n",
        "    A1 = tanh(Z1)\n",
        "\n",
        "    Z2 = np.dot(A1, W2) + b2\n",
        "\n",
        "    return Z2\n",
        "\n",
        "# Test Neural Network\n",
        "output = forward(X)\n",
        "\n",
        "print(\"Neural Network Output:\")\n",
        "print(output[:5])"
      ],
