        "\n",
        "# Create a small noisy dataset\n",
        "np.random.seed(42)\n",
        "X = np.linspace(-3, 3, 100).reshape(-1, 1)\n",
        "y = np.sin(X) + np.random.normal(\n",
        "    0, 0.3, X.shape)\n",
        "# Plot dataset\n",
        "plt.scatter(X, y, color=\"blue\")\n",
        "plt.title(\"Noisy Dataset\")\n",
        "plt.xlabel(\"Input (X)\")\n",
