      "source": [
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-np.clip(z, -500, 500)))\n",
        "\n",
        "def train_model(reg_type=\"none\"):\n",
        "\n",
        "    rng = np.random.default_rng(42)\n",
        "\n",
        "    W1 = rng.normal(0, 0.5, (2, 20))\n",
        "    b1 = np.zeros((1, 20))\n",
        "\n",
        "    W2 = rng.normal(0, 0.5, (20, 1))\n",
        "    b2 = np.zeros((1, 1))\n",
        "\n",
        "    lr = 0.1\n",
        "    epochs = 3000\n",
        "    l2 = 0.01\n",
        "    dropout_rate = 0.2\n",
        "\n",
        "    train_losses = []\n",
        "    val_losses = []\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "\n",
        "        # Forward propagation\n",
        "        A1 = np.tanh(X_train_cls @ W1 + b1)\n",
        "\n",
        "        if reg_type == \"dropout\":\n",
        "            mask = (\n",
        "                rng.random(A1.shape) >= dropout_rate\n",
        "            ) / (1 - dropout_rate)\n",
        "\n",
        "            A1_used = A1 * mask\n",
        "        else:\n",
        "            mask = np.ones_like(A1)\n",
        "            A1_used = A1\n",
        "\n",
        "        predictions = sigmoid(A1_used @ W2 + b2)\n",
        "\n",
        "        # Backpropagation\n",
        "        m = len(X_train_cls)\n",
        "\n",
        "        dZ2 = (predictions - y_train_cls) / m\n",
        "\n",
        "        dW2 = A1_used.T @ dZ2\n",
        "        db2 = np.sum(dZ2, axis=0, keepdims=True)\n",
        "\n",
        "        dA1 = (dZ2 @ W2.T) * mask\n",
        "        dZ1 = dA1 * (1 - A1**2)\n",
        "\n",
        "        dW1 = X_train_cls.T @ dZ1\n",
        "        db1 = np.sum(dZ1, axis=0, keepdims=True)\n",
        "\n",
        "        if reg_type == \"l2\":\n",
        "            dW1 += 2 * l2 * W1\n",
        "            dW2 += 2 * l2 * W2\n",
        "\n",
        "        # Update weights\n",
        "        W1 -= lr * dW1\n",
        "        b1 -= lr * db1\n",
        "\n",
        "        W2 -= lr * dW2\n",
        "        b2 -= lr * db2\n",
        "\n",
        "        # Evaluate without dropout\n",
        "        train_pred = sigmoid(\n",
        "            np.tanh(X_train_cls @ W1 + b1) @ W2 + b2\n",
        "        )\n",
        "\n",
        "        val_pred = sigmoid(\n",
        "            np.tanh(X_val_cls @ W1 + b1) @ W2 + b2\n",
        "        )\n",
        "\n",
        "        eps = 1e-8\n",
        "\n",
        "        train_loss = -np.mean(\n",
        "            y_train_cls * np.log(train_pred + eps)\n",
        "            + (1 - y_train_cls) * np.log(1 - train_pred + eps)\n",
        "        )\n",
        "\n",
        "        val_loss = -np.mean(\n",
        "            y_val_cls * np.log(val_pred + eps)\n",
        "            + (1 - y_val_cls) * np.log(1 - val_pred + eps)\n",
        "        )\n",
        "\n",
        "        train_losses.append(train_loss)\n",
        "        val_losses.append(val_loss)\n",
        "\n",
        "    train_accuracy = np.mean(\n",
        "        (train_pred >= 0.5) == y_train_cls\n",
        "    ) * 100\n",
        "\n",
        "    val_accuracy = np.mean(\n",
        "        (val_pred >= 0.5) == y_val_cls\n",
        "    ) * 100\n",
        "\n",
        "    return (\n",
        "        train_accuracy,\n",
        "        val_accuracy,\n",
        "        train_losses,\n",
        "        val_losses\n",
        "    )\n",
        "\n",
        "print(\"Neural Network Function Created!\")"
